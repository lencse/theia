{
   "extends": "@repo/typescript-config/base.json",
   "include": ["**/*.ts", "**/*.tsx"],
   "exclude": ["node_modules", "dist"],
   "compilerOptions": {
      "jsx": "react-jsx",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "noEmit": true,
      "declaration": false,
      "declarationMap": false,
      "verbatimModuleSyntax": true,
      "types": ["vite/client"],
      "paths": {
         "#/*": ["./src/*"]
      }
   }
}
