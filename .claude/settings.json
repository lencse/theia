{
   "hooks": {
      "PostToolUse": [
         {
            "matcher": "Write|Edit",
            "hooks": [
               {
                  "type": "command",
                  "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/biome check --write --no-errors-on-unmatched \"$f\"; } >/dev/null 2>&1 || true",
                  "statusMessage": "Formatting with Biome..."
               }
            ]
         }
      ]
   }
}
